#usda 1.0
(
    defaultPrim = "quadruped"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Quadruped robot (AK10-9 / AK70-10, 2020 profiles) exported from Fusion. Zero pose = straight standing stance. Links are rigid bodies at identity; joint frames and CoM are in that frame."
)

